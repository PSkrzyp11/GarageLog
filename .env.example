# Copy to .env and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# Required in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me

# Used by docker compose for the PostgreSQL container.
POSTGRES_USER=garagelog
POSTGRES_PASSWORD=garagelog
POSTGRES_DB=garagelog

# Used by the app when run outside Docker (uv run uvicorn ...).
DATABASE_URL=postgresql+psycopg://garagelog:garagelog@localhost:5432/garagelog
