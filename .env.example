# Copy to .env and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# Required in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me

# Used by docker compose for the PostgreSQL container.
POSTGRES_USER=garagelog
POSTGRES_PASSWORD=garagelog
POSTGRES_DB=garagelog

# Used by the app, Alembic and tests when run outside Docker (uv run ...).
# Use 127.0.0.1 rather than localhost (localhost may resolve to IPv6 and hang on Windows).
DATABASE_URL=postgresql+psycopg://garagelog:garagelog@127.0.0.1:5432/garagelog

# false: the sign-up page is closed (for a public server; see deploy/README.md).
# REGISTRATION_OPEN=true

# Database backups (the "backup" service in compose.yaml). A folder synced to the cloud,
# e.g. C:/Users/<you>/OneDrive/GarageLog-backups, also protects against a broken disk.
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=30

# Optional: tests use DATABASE_URL with the database name "garagelog_test" by default.
# TEST_DATABASE_URL=postgresql+psycopg://garagelog:garagelog@127.0.0.1:5432/garagelog_test
