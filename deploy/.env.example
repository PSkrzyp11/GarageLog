# Copy to deploy/.env on the server and fill in. Never commit .env.

# The address the app will have; its DNS A (and AAAA) record must point at this server.
DOMAIN=garagelog.example.com

# A random value of at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Letters and digits only (it becomes part of the database URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Create your own account first, then set false and run `docker compose up -d`.
REGISTRATION_OPEN=true

# Backups (scripts/backup.sh); the folder is relative to deploy/.
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=30
